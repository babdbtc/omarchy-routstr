{
  "schemaVersion": 1,
  "id": "io.github.babdbtc.routstr",
  "name": "Routstr",
  "version": "0.2.0",
  "author": "babdbtc",
  "license": "MIT",
  "description": "Buy Routstr AI inference privately: fund a local routstrd with Lightning or Cashu, watch the balance, top up from the bar. No account.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Routstr",
    "description": "Routstr balance in the bar, with Lightning and Cashu top-up. Optionally points OpenCode and friends at the daemon.",
    "category": "Widgets",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 30,
      "lowBalanceSats": 100,
      "hideBalance": false,
      "autoWireOpencode": false,
      "defaultTopupSats": 2100
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 30
      },
      {
        "key": "lowBalanceSats",
        "type": "integer",
        "label": "Low-balance warning (sats)",
        "min": 0,
        "max": 210000,
        "step": 10,
        "defaultValue": 100
      },
      {
        "key": "hideBalance",
        "type": "boolean",
        "label": "Hide sats amount in the bar",
        "defaultValue": false
      },
      {
        "key": "autoWireOpencode",
        "type": "boolean",
        "label": "Connect OpenCode automatically (edits opencode.json without asking)",
        "defaultValue": false
      },
      {
        "key": "defaultTopupSats",
        "type": "integer",
        "label": "Default top-up amount (sats)",
        "min": 21,
        "max": 210000,
        "step": 21,
        "defaultValue": 2100
      }
    ]
  }
}
